# Default local demo mode. It makes deterministic text and local SVG images; no external key needed.
AI_ARTICLE_STUDIO_APP_MODE=mock
AI_ARTICLE_STUDIO_DATABASE_URL=sqlite:///data/ai_article_studio.db
AI_ARTICLE_STUDIO_UPLOAD_DIR=uploads/images

# Switch to real only after configuring an OpenAI-compatible endpoint.
# AI_ARTICLE_STUDIO_APP_MODE=real
# AI_ARTICLE_STUDIO_OPENAI_BASE_URL=https://your-openai-compatible-endpoint
# AI_ARTICLE_STUDIO_OPENAI_API_KEY=
# LLM_API_KEY is also accepted for compatibility with the Java edition.
# AI_ARTICLE_STUDIO_OPENAI_MODEL=

# Optional visual quality review. Leave VISION_MODEL empty to avoid the extra
# per-image model call. Base URL and key default to OPENAI_* above when blank.
# DashScope OpenAI-compatible examples: qwen-vl-plus or qwen3-vl-plus.
# AI_ARTICLE_STUDIO_VISION_MODEL=
# AI_ARTICLE_STUDIO_VISION_BASE_URL=
# AI_ARTICLE_STUDIO_VISION_API_KEY=

# DashScope (百炼) example. Its base URL already includes /v1.
# AI_ARTICLE_STUDIO_APP_MODE=real
# AI_ARTICLE_STUDIO_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_ARTICLE_STUDIO_OPENAI_API_KEY=your-dashscope-api-key
# AI_ARTICLE_STUDIO_OPENAI_MODEL=qwen-plus

# Explicit image providers only. AUTO uses Pexels -> SiliconFlow -> Picsum;
# Google AI is never used by AUTO.
# AI_ARTICLE_STUDIO_PEXELS_API_KEY=
# AI_ARTICLE_STUDIO_SILICONFLOW_API_KEY=
# AI_ARTICLE_STUDIO_GOOGLE_AI_API_KEY=
# SiliconFlow image generation defaults (restart after changing these values).
# AI_ARTICLE_STUDIO_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# AI_ARTICLE_STUDIO_SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
# AI_ARTICLE_STUDIO_SILICONFLOW_IMAGE_SIZE=1024x1024
# AI_ARTICLE_STUDIO_SILICONFLOW_BATCH_SIZE=1
# AI_ARTICLE_STUDIO_SILICONFLOW_NUM_INFERENCE_STEPS=20
# AI_ARTICLE_STUDIO_SILICONFLOW_GUIDANCE_SCALE=7.5
# For Qwen/Qwen-Image models only (Kolors ignores this field):
# AI_ARTICLE_STUDIO_SILICONFLOW_CFG=4.0
